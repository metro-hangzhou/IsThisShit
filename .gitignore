# Root-anchored ignore rules only.
# Do not use loose names like `dist/` or `cache/` without a leading `/`.
# In this repository, unanchored directory names have already masked required
# vendored runtime assets such as `NapCat/.../node_modules/.../dist/*`.

/.idea/
/.venv/
/.tmp/
/.tmp*/
/.tmp*
/tmp*/
/.pytest_*/
/pytest-cache-files-*/
/Coding_ProjectIsThisShit.tmppytest_basetemp/
/.pytest_cache/
/.ruff_cache/
/.uv-cache/
/__pycache__/
/README.local.md
/probe_apply_patch_path.txt
/qq_login_qr.png
/*.zip
/.claude/
/.codex
/claude-code/
/dist/
/exports/
/state/
/licensing-drafts/
/review_editor_human_feedback_list/
/runtime_site_packages/
/python_runtime/
/dev/archive/
# Local NapCat runtime worktree. The parent repository references upstream
# runtime through the NapCatQQ submodule and keeps our fast plugin under
# /plugins/napcat-plugin-qq-data-fast instead of tracking runtime binaries.
/NapCat/
# Local legacy review-editor worktree. The tracked standalone app now lives in
# /subrepos/review-editor.
/apps/review-editor/
/apps/*/node_modules/
/apps/*/dist/
/apps/*/state/
/apps/*/.vite/
/apps/*/coverage/
/apps/**/*.bak-*
/apps/*/src-tauri/target/

# Local ORCH/Agent implementation worktree. The tracked standalone app now
# lives in /subrepos/orch-agent; the parent repo only keeps exporter/runtime
# code plus submodule references.
/src/qq_data_analysis/
/src/qq_data_process/
/src/surfaces/

